+            denied.code, AUTH_REQUIRED,
+            "revoked issuer fails closed: a dropped alias is an unknown provider"
+        );
+        let still_ok = auth
+            .authenticate(
+                TransportKind::Wss,
+                Credential::None,
+                Some("corp-at"),
+                Some("oidc.corp"),
+            )
+            .await
+            .expect("the surviving issuer is unaffected");
+        assert_eq!(still_ok.principal.id, corp_conn.principal.id);
+    }
