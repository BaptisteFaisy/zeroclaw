+        // A matching state carrying a foreign `iss` is a mix-up: refused
+        // before the code is exchanged.
+        let flow_state = start_login(&router).await;
+        let response = send(
+            &router,
+            "GET",
+            &format!("/oidc/callback?code=auth-1&state={flow_state}&iss={foreign}"),
+            "gw.local",
