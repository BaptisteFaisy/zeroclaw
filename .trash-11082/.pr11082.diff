+            "GET",
+            "/oidc/login/corp",
+            "gw.local",
+            None,
+            &[],
+        )
+        .await;
+        assert_eq!(
+            response.status(),
+            StatusCode::TEMPORARY_REDIRECT,
+            "another client must not pay for the first one's parked flows"
+        );
