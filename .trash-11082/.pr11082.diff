-        }
-
-        let now = std::time::SystemTime::now()
-            .duration_since(std::time::UNIX_EPOCH)
-            .unwrap_or_default()
-            .as_secs();
-
-        let mut roles = body.realm_access.map(|ra| ra.roles).unwrap_or_default();
-        roles.sort();
-        roles.dedup();
-
-        let identity = NevisIdentity {
