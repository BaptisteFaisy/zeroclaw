-            scopes: body
-                .scope
-                .unwrap_or_default()
-                .split_whitespace()
-                .map(String::from)
-                .collect(),
-            mfa_verified: body.acr.as_deref() == Some("mfa")
-                || body
-                    .amr
-                    .iter()
-                    .flatten()
-                    .any(|m| m == "fido2" || m == "passkey" || m == "otp" || m == "webauthn"),
-            session_expiry: now + self.session_timeout.as_secs(),
-        };
-
-        if self.require_mfa && !identity.mfa_verified {
